<Page
    x:Class="Verity.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Verity.WinUI.Converters"
    xmlns:controls="using:Verity.WinUI.Controls"
>

    <Page.Resources>
        <converters:BoolToHorizontalAlignmentConverter x:Key="BubbleAlignment" />
        <converters:BoolToBubbleBrushConverter x:Key="BubbleBrush" />
        <converters:BoolToTimestampBrushConverter x:Key="TimestampBrush" />
        <converters:BoolToAvailabilityTextConverter x:Key="AvailabilityText" />
    </Page.Resources>

    <Grid Background="#FF151D26">
        <!-- First-run Telegram onboarding -->
        <Border
            x:Name="OnboardingPanel"
            Width="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FF16181C"
            BorderBrush="#FF2F3336"
            BorderThickness="1"
            CornerRadius="16"
            Visibility="Collapsed">
            <StackPanel Spacing="16">
                <TextBlock
                    x:Name="OnboardingTitle"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#FFE7E9EA"
                    Text="Connect Verity to Telegram" />
                <TextBlock
                    x:Name="OnboardingDescription"
                    Foreground="#FF71767B"
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="OnboardingInput"
                    KeyDown="OnboardingInput_KeyDown" />
                <PasswordBox
                    x:Name="OnboardingPassword"
                    KeyDown="OnboardingInput_KeyDown"
                    Visibility="Collapsed" />
                <Button
                    x:Name="OnboardingContinue"
                    HorizontalAlignment="Stretch"
                    Click="OnboardingContinue_Click"
                    Content="Continue" />
                <TextBlock
                    x:Name="OnboardingStatus"
                    FontSize="12"
                    Foreground="#FF71767B"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Main chat shell -->
        <Grid x:Name="ChatRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Grid Background="#FF1C2733">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFFFF"
                        Text="Verity" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Refresh_Click"
                        Content="⟳"
                        FontSize="16"
                        Foreground="#FF7D8E98"
                        Padding="8,2" />
                </Grid>
                <ListView
                    x:Name="BotsList"
                    Grid.Row="1"
                    Padding="6"
                    Background="Transparent"
                    SelectionChanged="BotsList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="42"
                                    Height="42"
                                    VerticalAlignment="Center"
                                    Background="#FF40A7E3"
                                    CornerRadius="21">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFFFF"
                                        Text="{Binding Initial}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="#FFFFFFFF"
                                        Text="{Binding Label}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#FF7D8E98"
                                        Text="{Binding Available, Converter={StaticResource AvailabilityText}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Grid.Row="2"
                    Margin="16,8"
                    FontSize="12"
                    Foreground="#FF7D8E98"
                    Text="Direct bot chats" />
            </Grid>

            <!-- conversation column -->
            <Grid Grid.Column="1" Background="#FF151D26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="14,8" Background="#FF1C2733">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="34"
                            Height="34"
                            VerticalAlignment="Center"
                            Background="#FF40A7E3"
                            CornerRadius="17">
                            <TextBlock
                                x:Name="ChatTitleInitial"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFFFF"
                                Text="V" />
                        </Border>
                        <TextBlock
                            x:Name="ChatTitle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFFFF"
                            Text="Verity" />
                    </Grid>
                </Border>

                <ListView
                    x:Name="MessagesList"
                    Grid.Row="1"
                    Padding="16,10"
                    Background="Transparent"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MaxWidth="560"
                                MinWidth="70"
                                Margin="0,3"
                                Padding="12,7"
                                HorizontalAlignment="{Binding IsMine, Converter={StaticResource BubbleAlignment}}"
                                Background="{Binding IsMine, Converter={StaticResource BubbleBrush}}"
                                CornerRadius="15">
                                <StackPanel Spacing="3">
                                    <controls:FormattedText Message="{Binding Message}" />
                                    <ItemsControl ItemsSource="{Binding MathImages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image
                                                    MaxWidth="520"
                                                    Margin="0,4"
                                                    HorizontalAlignment="Left"
                                                    Source="{Binding Source}"
                                                    Stretch="Uniform" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding Reactions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        MinHeight="22"
                                                        Margin="0,2,4,0"
                                                        Padding="8,1"
                                                        Background="#33FFFFFF"
                                                        BorderThickness="0"
                                                        Click="Reaction_Click"
                                                        Content="{Binding Display}"
                                                        CornerRadius="11"
                                                        FontSize="12"
                                                        Tag="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="11"
                                            Foreground="{Binding IsMine, Converter={StaticResource TimestampBrush}}"
                                            Text="{Binding Time}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="2" Padding="12,6">
                    <!-- Unigram-style integrated composer: one rounded bar with
                         glyph buttons inside, not separate controls -->
                    <Border
                        Background="#FF242F3D"
                        CornerRadius="21"
                        MinHeight="42">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="42"
                                Height="42"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="📎"
                                FontSize="16"
                                Opacity="0.6" />
                            <TextBox
                                x:Name="Composer"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                KeyDown="Composer_KeyDown"
                                MinHeight="40"
                                Padding="0,6"
                                PlaceholderText="Message" />
                            <Button
                                Grid.Column="2"
                                Width="42"
                                Height="42"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="Send_Click"
                                Content="➤"
                                FontSize="15"
                                Foreground="#FF40A7E3" />
                        </Grid>
                    </Border>
                </Border>

                <TextBlock
                    x:Name="StatusText"
                    Grid.Row="3"
                    Margin="16,0,16,8"
                    FontSize="12"
                    Foreground="#FF7D8E98"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <!-- Post-login setup: harness choice + first bot creation.
             Comes last so it renders above the (empty) chat shell. -->
        <Border
            x:Name="SetupPanel"
            Width="480"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FF16181C"
            BorderBrush="#FF2F3336"
            BorderThickness="1"
            CornerRadius="16"
            Visibility="Collapsed">
            <ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- step 1: harness -->
                    <StackPanel x:Name="StepHarness" Spacing="10">
                        <TextBlock FontSize="12" Foreground="#FF71767B" Text="step 1 of 3" />
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#FFE7E9EA"
                            Text="Pick your agent harness" />
                        <TextBlock
                            Foreground="#FF71767B"
                            Text="The harness is what powers your bots' brains. Missing ones can be installed right here."
                            TextWrapping="Wrap" />
                        <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch" SelectionChanged="ProviderBox_SelectionChanged">
                            <ComboBoxItem Content="devin — Devin over ACP" Tag="devin" />
                            <ComboBoxItem Content="pi — pi agent CLI" Tag="pi" />
                            <ComboBoxItem Content="echo — test harness, no agent" Tag="echo" />
                            <ComboBoxItem Content="claude-code-acp — Claude over ACP" Tag="claude-code-acp" />
                            <ComboBoxItem Content="codex acp — Codex over ACP" Tag="codex" />
                            <ComboBoxItem Content="custom — any other ACP command" Tag="acp-custom" />
                        </ComboBox>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="HarnessDetectStatus"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FF71767B"
                                Text="detecting…"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="HarnessInstall"
                                Grid.Column="1"
                                Click="HarnessInstall_Click"
                                Content="Install"
                                Padding="12,4"
                                Visibility="Collapsed" />
                        </Grid>
                        <TextBox
                            x:Name="PiBinBox"
                            PlaceholderText="pi binary (default: pi)"
                            Visibility="Collapsed" />
                        <TextBox
                            x:Name="AcpSpecBox"
                            PlaceholderText="ACP command, e.g. claude-code-acp"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="HarnessNext"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Click="HarnessNext_Click"
                            Content="Continue" />
                        <Button
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SetupSkip_Click"
                            Content="skip setup for now"
                            Foreground="#FF71767B" />
                    </StackPanel>

                    <!-- step 2: bot source -->
                    <StackPanel x:Name="StepSource" Spacing="12" Visibility="Collapsed">
                        <TextBlock FontSize="12" Foreground="#FF71767B" Text="step 2 of 3" />
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#FFE7E9EA"
                            Text="Now, your bot" />
                        <TextBlock
                            Foreground="#FF71767B"
                            Text="Create a fresh bot through @BotFather, or register one you already have a token for."
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="SourceCreate_Click"
                            Padding="16,12">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Create a new bot" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#FF9B9FA3"
                                    Text="the app talks to @BotFather for you" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="SourceRegister_Click"
                            Padding="16,12">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Register an existing token" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#FF9B9FA3"
                                    Text="you already have a token from @BotFather" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BackToHarness_Click"
                            Content="← back"
                            Foreground="#FF71767B" />
                    </StackPanel>

                    <!-- step 3: details (create or register) -->
                    <StackPanel x:Name="StepDetails" Spacing="10" Visibility="Collapsed">
                        <TextBlock FontSize="12" Foreground="#FF71767B" Text="step 3 of 3" />
                        <TextBlock
                            x:Name="StepDetailsTitle"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#FFE7E9EA"
                            Text="Create your bot" />
                        <TextBox x:Name="BotNameBox" PlaceholderText="bot name (roster label, e.g. rey)" />
                        <TextBox x:Name="BotUsernameBox" PlaceholderText="username — must end in 'bot'" />
                        <TextBox
                            x:Name="BotTokenBox"
                            PlaceholderText="token from @BotFather"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="OptionalToggle"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OptionalToggle_Click"
                            Content="＋ personality, model and greeting (optional)"
                            Foreground="#FF71767B"
                            Padding="0" />
                        <StackPanel
                            x:Name="OptionalFields"
                            Spacing="10"
                            Visibility="Collapsed">
                            <TextBox x:Name="InstructionsBox" PlaceholderText="personality / instructions" />
                            <TextBox x:Name="ModelBox" PlaceholderText="model override" />
                            <TextBox x:Name="GreetingBox" PlaceholderText="greeting — first DM message" />
                        </StackPanel>
                        <Button
                            x:Name="SetupCreate"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Stretch"
                            Click="SetupCreate_Click"
                            Content="Create bot" />
                        <TextBlock
                            x:Name="SetupStatus"
                            FontSize="12"
                            Foreground="#FF71767B"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BackToSource_Click"
                            Content="← back"
                            Foreground="#FF71767B" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
